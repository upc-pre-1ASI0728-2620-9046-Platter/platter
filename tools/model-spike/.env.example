# Copia este archivo a .env (no se sube al repositorio) y pega tus claves.
# Basta con una: el proveedor sin clave se omite.

# Tripo · https://platform.tripo3d.ai → API Keys (la clave secreta empieza con "tsk_")
TRIPO_API_KEY=
# TRIPO_MODEL=v3.1-20260211

# Meshy · https://www.meshy.ai → Settings → API
MESHY_API_KEY=
# MESHY_MODEL=latest
