# Copia a .env y completa. Sin GEMINI_API_KEY el análisis IA responde 503 y la app pasa a carga manual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
JWT_SECRET=reemplaza-por-un-secreto-aleatorio-de-al-menos-32-bytes
# URL pública que se codifica en los QR (usa la IP de tu PC en la red local para probar desde el celular)
PUBLIC_WEB_URL=http://localhost:8081
# Puerto del host para la API directa (la app Flutter usa http://localhost:<puerto>/api/v1)
BACKEND_PORT=8080
